{
  "name": "agentcore-payments-buyer-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal buyer-side harness for AWS Bedrock AgentCore payments (x402 / MPP), testnet only.",
  "scripts": {
    "mock:merchant": "tsx mock/server.ts",
    "harness": "tsx src/cli.ts",
    "run:all": "tsx scripts/run-all.ts",
    "check:tools": "tsx scripts/check-tool-surface.ts",
    "check:secrets": "tsx scripts/check-no-key-material.ts",
    "typecheck": "tsc --noEmit",
    "provision": "tsx scripts/provision-agentcore.mts",
    "check:ga": "tsx scripts/check-ga-shapes.ts",
    "check:redaction": "tsx scripts/check-redaction.ts",
    "check": "npm run typecheck && npm run check:tools && npm run check:ga && npm run check:redaction && npm run check:guards && npm run check:facilitator && npm run check:secrets && npm run check:keys",
    "check:facilitator": "tsx scripts/check-facilitator.ts",
    "ac1": "tsx scripts/ac1/run.ts",
    "ac3": "tsx scripts/ac3/run.ts",
    "check:guards": "tsx scripts/check-guards.ts",
    "check:keys": "tsx scripts/check-keys-everywhere.ts",
    "ac4:probe": "tsx src/cli.ts --probe-only --label=ac4-probe --run-id=probe --out=artifacts/ac4 --endpoints=@config/probe-targets.json",
    "ac4:normalize": "tsx scripts/ac4/normalize.ts",
    "check:py": "python3 scripts/ac2/check_payto_guard.py"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1117.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1117.0",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
